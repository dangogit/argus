# Argus runtime env. Copy to .env or another private file and load it with:
# export ARGUS_ENV_FILES=/absolute/path/to/.env
#
# Keep secrets here, not in argus.yaml. Keep paths absolute for host jobs.

# --- Required for local runtime ---
# ARGUS_CONFIG=/absolute/path/to/argus.yaml
# ARGUS_CONFIG_V2=/absolute/path/to/argus.yaml
# ARGUS_DB_DSN=host=127.0.0.1 port=5440 dbname=argus user=argus password=argus
# ARGUS_RUN_ROOT=/absolute/path/to/argus-run

# --- Engine and CLI integration ---
# GITHUB_TOKEN=                  # copied to GH_TOKEN by Argus if GH_TOKEN is unset
# ARGUS_ENGINE=echo              # echo, codex, claude-code, hermes
# ARGUS_FALLBACK_ENGINE=echo
# ARGUS_AGENT_CWD=/absolute/path/to/workdir
# ARGUS_ENGINE_TIMEOUT=900
# ARGUS_ENGINE_MAX_RETRIES=2
# ARGUS_ENGINE_RETRY_DELAY=5

# Codex engine
# ARGUS_CODEX_BIN=codex
# ARGUS_CODEX_SANDBOX=workspace-write
# ARGUS_CODEX_STDIN=1
# ARGUS_CODEX_NETWORK=0

# Claude Code engine
# ARGUS_CLAUDE_BIN=claude
# ARGUS_CLAUDE_TOOLS=Read,Grep,Glob
# ARGUS_CLAUDE_PERMISSION_MODE=default

# Hermes engine
# ARGUS_HERMES_BIN=hermes
# ARGUS_HERMES_HOME_ROOT=/absolute/path/to/hermes-home
# ARGUS_HERMES_TOOLSETS=file,web,memory

# --- Security knobs (all optional; safe defaults when unset) ---
# Inbound command channels
# ARGUS_WEBHOOK_SECRET=           # referenced by company.defaults.webhook_secret
# ARGUS_PUBLIC_URL=https://argus.example.com/slack
# ARGUS_WA_WEBHOOK_SECRET=        # legacy WhatsApp-specific shared secret
# ARGUS_WA_MAX_AGE_SEC=300        # reject webhook payloads older than N seconds (replay window); unset = off
# ARGUS_WA_STATUS_WINDOW=500      # status counts errors/warns over the last N alerts
# ARGUS_WA_LIST_WINDOW=200        # list reads the last N alerts

# Notification policy overrides
# Prefer company.defaults.notifications in argus.yaml for long-lived policy.
# ARGUS_NOTIFY_TIMEZONE=UTC
# ARGUS_NOTIFY_QUIET_HOURS=22:30-08:30

# Dashboard
# ARGUS_DASHBOARD_TOKEN=          # required for dashboard routes except /api/health
# ARGUS_DASHBOARD_HOST=127.0.0.1  # bind host; doctor warns if non-loopback without a token

# PM prompt hardening
# ARGUS_PM_UNTRUSTED_MAX=4000     # cap on untrusted finding text fenced into role prompts

# --- Connectors and transports ---
# Use names referenced by config secret_ref fields. Examples:
# SENTRY_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Vercel connector can also use `vercel login` CLI auth when no secret_ref is set.
# VERCEL_TOKEN=
# VERCEL_PROJECT=
# VERCEL_TEAM=
# POSTHOG_TOKEN=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=
# Firebase connector can also use `firebase login` CLI auth when no secret_ref is set.
# FIREBASE_AUTH_FILE=
# SUPPORT_APPS_SCRIPT_URL=
# SUPPORT_APPS_SCRIPT_KEY=
# ARGUS_PERSONAL_GMAIL_APPS_SCRIPT_URL=
# ARGUS_PERSONAL_GMAIL_APPS_SCRIPT_KEY=

# WhatsApp and owner advisor bridge
# ARGUS_WA_URL=http://127.0.0.1:8080
# ARGUS_WA_INSTANCE=
# ARGUS_WA_APIKEY_FILE=/absolute/path/to/wa.key
# ARGUS_ADVISOR_GROUPS=
# ARGUS_ADVISOR_BOT_IDS=

# Telegram inbound/outbound channel
# TELEGRAM_BOT_TOKEN=

# Slack inbound/outbound channel
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Google Calendar
# ARGUS_GCAL_ACCESS_TOKEN=
# ARGUS_GCAL_CALENDAR_ID=
# ARGUS_GCAL_SA_KEY=/absolute/path/to/service-account.json

# Content publishing (HIGH RISK: an LLM posts to a live account)
# ARGUS_CONTENT_PUBLISH_ENABLED=0       # 1 = allow a real (non-echo) publisher driver
# ARGUS_CONTENT_PLATFORMS="linkedin x"  # allowlist of publish targets

# Alert store
# ARGUS_ALERT_MAX_LINES=5000      # rotate alerts.jsonl past this many lines
